rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// LEO · Firestore Security Rules — FECHADURA DEFINITIVA (modelo de contas)
// ════════════════════════════════════════════════════════════════════
// ✅ PUBLICADA em 10/08/2026 (Fase 5, Plano 2A) — substituiu a tranca
//    provisoria de 09/08. Pre-requisitos que permitiram a troca:
//    /api/signup (cadastro server-side), billing por contaId, /api/exame
//    (apagar/cancelar/transferir). Rollback: tag pre-fase5 +
//    scripts/secao1/04-publicar-regras.mjs --file=<backup> --commit
//
// Modelo: CONTA (paga) → LOCAL (workspaces) → exames/pacientes
//         MEMBRO = vinculos/{contaId}_{uid} com papel + locais
// Spec: docs/decisoes/2026-08-09-secao1-contas-e-acesso.md
//
// O Wader usa Service Account (Admin SDK) e nao e afetado por nada aqui.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fundamentos ──
    function auth() { return request.auth != null; }
    function uid()  { return request.auth.uid; }

    function superadmin() {
      return auth()
        && exists(/databases/$(database)/documents/profissionais/$(uid()))
        && get(/databases/$(database)/documents/profissionais/$(uid())).data.superadmin == true;
    }

    function vincRef(contaId) {
      return /databases/$(database)/documents/vinculos/$(contaId + '_' + uid());
    }
    // Exige papel valido: vinculo ativo mas sem `papel` (malformado ou
    // meio-criado) nao pode conceder acesso clinico so por existir.
    function temVinculo(contaId) {
      return auth() && exists(vincRef(contaId))
        && get(vincRef(contaId)).data.status == 'ativo'
        && get(vincRef(contaId)).data.papel in ['dono', 'medico', 'recepcao'];
    }
    function vinc(contaId) { return get(vincRef(contaId)).data; }
    function ehPapel(contaId, p) { return temVinculo(contaId) && vinc(contaId).papel == p; }

    // Recebe o contaId pronto: serve para `get` E para `list` (numa consulta,
    // `resource` e cada documento avaliado — nao da para get() do proprio doc).
    function alcancaConta(contaId, wsId) {
      return temVinculo(contaId)
        && (vinc(contaId).locais.size() == 0 || wsId in vinc(contaId).locais);
    }
    // Em subcolecoes o doc do local nao esta em `resource`: aqui o get() e
    // inevitavel. Sao 2 gets no total, longe do limite de 10.
    function contaDoLocal(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)).data.contaId;
    }
    function alcancaLocal(wsId) { return alcancaConta(contaDoLocal(wsId), wsId); }
    function ehDonoDoLocal(wsId) { return ehPapel(contaDoLocal(wsId), 'dono'); }
    function ehMedicoNoLocal(wsId) {
      return alcancaLocal(wsId) && vinc(contaDoLocal(wsId)).papel in ['dono', 'medico'];
    }

    // Ato medico: tipoPerfil ausente conta como medico (default do app, licao do
    // apagao de cadastro 09/08) OU == 'medico' explicito. Qualquer outro valor
    // ('assistente', 'gestor', typo, '') NAO e medico — mesmo criterio do
    // /api/emitir (matriz §4). E o eixo que a decisao do Dr. Sergio (ADR 8.4)
    // exige para editar/liberar laudo.
    function ehMedicoDeVerdade(u) {
      return exists(/databases/$(database)/documents/profissionais/$(u))
        && get(/databases/$(database)/documents/profissionais/$(u)).data.get('tipoPerfil', 'medico') == 'medico';
    }

    // Precisa resistir a setDoc() sem merge: nesse caso a operacao ainda e
    // classificada como 'update', mas request.resource.data so tem os
    // campos enviados — o campo protegido pode desaparecer do resultado.
    // Por isso nao basta checar ausencia; se existia antes, tem que
    // continuar existindo com o mesmo valor.
    function intacto(campo) {
      return (campo in resource.data)
        ? (campo in request.resource.data && request.resource.data[campo] == resource.data[campo])
        : !(campo in request.resource.data);
    }

    // Campos ADMINISTRATIVOS do exame (pre-assinatura): identificacao do
    // paciente, agendamento, convenio, metadados de fila. TUDO que o Worklist
    // grava no cadastro — saveExame manual + import Feegow (src/components/
    // Worklist.tsx) + os campos que saveExame acrescenta (src/lib/firestore.ts:
    // id, status, versao, medicoUid, criadoEm, atualizadoEm). Conteudo CLINICO
    // (medidas, achados, conclusoes, imagensSelecionadasPdf, medidasDicom...)
    // NAO esta aqui: por ser whitelist, qualquer campo clinico OU desconhecido
    // tocado por nao-medico e negado (fail-closed). Decisao Dr. Sergio (ADR 8.4):
    // editar/liberar conteudo de laudo, ate em rascunho, e ATO MEDICO.
    function camposAdministrativos() {
      return ['id', 'acc', 'pacienteId', 'pacienteNome', 'pacienteDtnasc',
        'cpf', 'feegowPacienteId', 'tipoExame', 'dataExame', 'horarioChegada',
        'status', 'convenio', 'solicitante', 'medicoExecutor', 'sexo', 'origem',
        'feegowAppointId', 'medicoUid', 'mwlStatus', 'versao', 'criadoEm', 'atualizadoEm'];
    }

    // ── CONTAS ── so o servidor cria e altera
    match /contas/{contaId} {
      allow get, list: if superadmin() || temVinculo(contaId);
      allow create, update, delete: if false;
    }

    // ── LOCAIS ──
    match /workspaces/{wsId} {
      allow get, list: if superadmin()
                       || (resource != null && alcancaConta(resource.data.contaId, wsId));
      // ortancAtivo intacto: espelho de integracoes/orthanc.ativo, so salvarIntegracao
      // (Admin SDK) escreve, sempre no mesmo batch de integracoes/orthanc.ativo (achado 17).
      allow update:    if superadmin()
                       || (ehDonoDoLocal(wsId) && intacto('contaId') && intacto('ortancAtivo'));
      allow create, delete: if false;

      // Gaveta de segredos: ninguem pelo navegador, nem o superadmin.
      match /privado/{documento=**} {
        allow read, write: if false;
      }

      // Integracoes (Sub-plano 5): configuracao e estado de Feegow/Orthanc/Wader.
      // Leitura: so o dono. O SEGREDO nao mora aqui — vai na gaveta privado/
      // acima, que nenhum cliente le.
      // Escrita: NINGUEM pelo cliente, nem o dono. Quem grava e sempre Admin
      // SDK — a rota /api/integracoes (salvarIntegracao) e o batimento do
      // Wader. Motivo: salvarIntegracao grava integracoes/orthanc.ativo e o
      // espelho workspaces/{wsId}.ortancAtivo no MESMO writeBatch; se o cliente
      // pudesse escrever aqui direto, ele mudaria orthanc.ativo sem o espelho
      // acompanhar — o botao "Importar DICOM" (SidebarLaudo.tsx) some da tela
      // do laudo com o Orthanc ligado, sem erro nenhum. Fechar a escrita e o
      // que garante que os dois nunca divergem.
      match /integracoes/{tipo} {
        allow read: if ehDonoDoLocal(wsId);
        allow write: if false;
      }

      // Perfil do aparelho (S4-T13): mapa medida-do-Vivid -> campo do laudo,
      // editavel no cartao Integracoes (decisao Sergio: transparencia total).
      // Diferente do generico /integracoes/{tipo} acima: SEM segredo, entao
      // o CLIENTE escreve direto (mesmo padrao de tiposLaudo abaixo) — nao
      // precisa de rota server-side so pra isso. Leitura: qualquer membro (o
      // medico quer ver o que o aparelho manda, nao so o dono). Escrita: so
      // o dono, mesma trava dos outros editores de integracoes.
      //
      // POR QUE ESTE BLOCO FUNCIONA CONVIVENDO COM O WILDCARD ACIMA: no
      // Firestore, TODOS os blocos `match` que casam com o caminho sao
      // avaliados e as permissoes sao UNIDAS (OR). NAO existe "o mais
      // especifico vence" — isso e regra de roteador, nao de security rules.
      // Aqui da certo porque o wildcard /integracoes/{tipo} NEGA write
      // (`allow write: if false` nao tira permissao de ninguem, so nao
      // concede) e este bloco CONCEDE create/update ao dono; a uniao concede.
      // ⚠️ Se algum dia o wildcard passar a CONCEDER algo mais amplo, este
      // bloco NAO vai restringir — a uniao continuaria concedendo o mais amplo.
      // (testado em tests/rules, secao 18).
      match /integracoes/perfilAparelho {
        allow read: if superadmin() || alcancaLocal(wsId);
        allow create, update: if ehDonoDoLocal(wsId)
          && request.resource.data.keys().hasOnly(['nome', 'mapeamentos', 'atualizadoEm', 'atualizadoPor']);
        allow delete: if false;
      }

      match /pacientes/{pacId} {
        allow read: if superadmin() || alcancaLocal(wsId);
        allow create, update: if alcancaLocal(wsId);
        allow delete: if ehDonoDoLocal(wsId);
      }

      match /exames/{exameId} {
        // `status` e DONO UNICO do servidor (fecha E10/E22) — motivo,
        // levantamento tela por tela e a lista de status legados que
        // obrigam a origem aberta: docs/decisoes/2026-08-30-secao7-regra-
        // status-DRAFT.md §2-3. Unica transicao legitima do navegador:
        // abrir/salvar o laudo (`status:'andamento'`).
        function statusSoDoServidor() {
          return resource.data.get('status', '') != 'cancelado'
            && (intacto('status')
                || (request.resource.data.get('status', '') == 'andamento'
                    && resource.data.get('status', '') != 'emitido'));
        }
        // Todo membro do local ve a fila e le o laudo do colega (D7 do spec)
        allow read:   if superadmin() || alcancaLocal(wsId);
        // Ninguem cria exame ja carimbado como 'emitido' pelo navegador —
        // nem o medico (era o mesmo E10 pela porta do create: laudo com cara
        // de assinado sem PDF, sem log e sem franquia). Quem nasce emitido e
        // sempre o Admin SDK (/api/emitir), que ignora regras. Grep 30/08:
        // o unico create do cliente e o cadastro da fila (Worklist.tsx:302),
        // sempre 'aguardando'.
        allow create: if alcancaLocal(wsId)
                      && request.resource.data.get('status', '') != 'emitido'
                      && (!('medicoUid' in request.resource.data)
                          || request.resource.data.medicoUid == uid()
                          || ehDonoDoLocal(wsId))
                      // Quem NAO e medico-no-local so cria exame com campos
                      // administrativos (cadastro/fila). Conteudo clinico ja no
                      // create = ato medico: exige perfil medico E papel dono/medico
                      // no local (igual /api/emitir). Medico-de-perfil com papel
                      // recepcao NAO atende aqui — fica preso a whitelist.
                      && (( ehMedicoDeVerdade(uid()) && ehMedicoNoLocal(wsId) )
                          || request.resource.data.keys().hasOnly(camposAdministrativos()));
        // Conteudo do laudo: o autor edita; um exame sem autor ainda pode
        // ser assumido por qualquer medico do local. O dono ajusta qualquer um.
        // `intacto('medicoUid')` fecha a transferencia disfarcada de edicao: sem
        // ela, o autor trocava o medicoUid para outro medico na mesma escrita,
        // passando por cima da rota de servidor que faz log e acerta franquia.
        // Assumir exame sem autor continua valendo (medicoUid nao existia).
        // Cancelar e do servidor (/api/exame): devolve franquia e loga. Pelo
        // navegador o status 'cancelado' viraria laudo sumido sem devolucao.
        // Reabrir 'emitido' para 'andamento' FECHADO para o autor (E22,
        // statusSoDoServidor acima) — a franquia ja foi cobrada e cancelar
        // so devolve com o status ainda 'emitido'.
        // Conteudo do laudo / reabrir emitido = ATO MEDICO (CRM) + autoria. Um
        // dono NAO-medico nao edita laudo (decisao Dr. Sergio, ADR 8.4).
        // Administracao da fila (exame NAO-emitido) continua do dono: paciente,
        // convenio, agendamento — pre-assinatura, nao e ato medico. Correcao
        // administrativa de EMITIDO vai pela /api/corrigir-laudo (log + servidor).
        allow update: if statusSoDoServidor()
                      && ((ehMedicoDeVerdade(uid()) && ehMedicoNoLocal(wsId)
                            && (!('medicoUid' in resource.data) || resource.data.medicoUid == uid())
                            && ('medicoUid' in resource.data ? intacto('medicoUid') : true)
                            // emitidoEm/pdfUrl so o servidor grava (emitir-admin.ts:390,
                            // publicarPdfSeAindaDono em :154) — sem isto o autor plantava
                            // metade do carimbo de emissao mesmo com `status` fechado.
                            && intacto('emitidoEm') && intacto('pdfUrl'))
                          || (alcancaLocal(wsId) && intacto('medicoUid')
                              && resource.data.get('status', '') != 'emitido'
                              // Qualquer MEMBRO do local (dono, medico, recepcao) mexe
                              // no ADMINISTRATIVO da fila pre-assinatura (Secao 2, A2).
                              // Campo clinico tocado aqui e negado (ADR 8.4); autor
                              // intacto; emitido corrige via /api/corrigir-laudo.
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposAdministrativos())));
        // Apagar/cancelar/transferir passam pelo servidor (log + franquia)
        allow delete: if false;
      }

      // Catalogo de tipos de laudo (Sub-plano 3): membro le (a Agenda lista
      // os tipos no cadastro), so o DONO configura. Whitelist fail-closed.
      match /tiposLaudo/{tipoId} {
        allow read: if superadmin() || alcancaLocal(wsId);
        allow create, update: if ehDonoDoLocal(wsId)
          && request.resource.data.keys().hasOnly(['id', 'nome', 'icone', 'ativo',
             'ordem', 'modalidade', 'motorId', 'modeloTexto', 'criadoEm', 'atualizadoEm'])
          && request.resource.data.modalidade in ['motor', 'texto', 'pdf'];
        allow delete: if ehDonoDoLocal(wsId);
      }

      // Honorarios, extratos e demais ajustes do local: financeiro, so quem
      // atende (medico) ou o dono — recepcao nao ve valor por convenio.
      // superadmin(): Lacuna 1 do levantamento — sem ele o suporte perdia
      // acesso a honorarios e contador de extrato (a publicada sempre teve).
      match /config/{docId}   { allow read, write: if superadmin() || ehMedicoNoLocal(wsId); }
      match /extratos/{docId} { allow read, write: if superadmin() || ehMedicoNoLocal(wsId); }
    }

    // ── VINCULOS ── leitura do proprio e do dono da conta; escrita so servidor
    match /vinculos/{vincId} {
      allow get:  if auth() && (resource.data.medicoUid == uid()
                    || ehPapel(resource.data.contaId, 'dono') || superadmin());
      // `list` por documento: a consulta so passa se for restrita ao proprio
      // usuario (where medicoUid == uid). Sem isso, um logado listaria o mapa
      // de quem pertence a que conta.
      allow list: if superadmin() || (auth() && resource.data.medicoUid == uid());
      allow create, update, delete: if false;
    }

    // ── ASSINATURAS ── id = contaId. Recepcao nao ve financeiro.
    // update superadmin: o Direx troca plano e ajusta creditos PELO NAVEGADOR
    // (licencas/page.tsx + ajustarCreditos). `if false` quebraria o painel.
    // Cliente comum continua sem escrever: franquia e so do servidor.
    match /subscriptions/{contaId} {
      allow get, list: if superadmin()
                       || (temVinculo(contaId) && vinc(contaId).papel in ['dono', 'medico']);
      allow update: if superadmin();
      allow create, delete: if false;
    }

    // ── PROFISSIONAIS ── proprio perfil, sem autopromocao, sem listar todos
    match /profissionais/{profId} {
      allow get:    if auth() && (profId == uid() || superadmin());
      allow list:   if superadmin();
      // `createProfile()` (src/lib/firestore.ts) SEMPRE envia superadmin:false.
      // Exigir o campo ausente quebra TODO cadastro novo — foi o que derrubou o
      // cadastro em producao das 18:34 as 22:53 de 09/08. O que nao pode e
      // nascer com superadmin:true ou com adminRole.
      allow create: if auth() && profId == uid()
                    && (!('superadmin' in request.resource.data)
                        || request.resource.data.superadmin == false)
                    && !('adminRole' in request.resource.data)
                    // O selo so nasce 'nao_verificado' pelo navegador. O cadastro
                    // real cria o perfil pelo servidor (Admin SDK, ignora regras);
                    // create client-side NUNCA pode nascer 'verificado' (selo forjado).
                    && (!('crmVerificacao' in request.resource.data)
                        || request.resource.data.crmVerificacao.status == 'nao_verificado');
      // `tipoPerfil` tambem e imutavel pelo proprio: /api/emitir exige perfil
      // medico para assinar laudo (matriz §4), e sem isso um assistente com
      // papel dono se autopromovia a medico e passava no gate. Reenviar o MESMO
      // valor continua valendo (intacto permite igual) — o PerfilModal manda o
      // campo em todo save; so a MUDANCA e negada. O Direx (branch separado) muda.
      // `crmVerificacao` (selo "CRM verificado no CFM") so o servidor/superadmin
      // seta — senao o medico gravava status:'verificado' em si e forjava o selo.
      // `crm`/`ufCrm` nascem no cadastro e nao mudam pelo proprio (a distincao e
      // do onboarding). Reenviar o mesmo valor continua passando (intacto).
      allow update: if superadmin()
                    || (auth() && profId == uid()
                        && intacto('superadmin') && intacto('adminRole') && intacto('tipoPerfil')
                        && intacto('crmVerificacao') && intacto('crm') && intacto('ufCrm'));
      allow delete: if false;
    }

    // ── EMPRESAS ── so o Direx. Tem CNPJ e endereco de todas as clinicas, e o
    // unico leitor no app e /direx/painel/clientes.
    match /empresas/{empId} {
      allow read:  if superadmin();
      allow write: if superadmin();
    }

    // ── Trilhas append-only ──
    match /logs/{logId} {
      allow create: if auth();
      allow read:   if superadmin();
      allow update, delete: if false;
    }
    // Ledger de franquia/creditos: SO o servidor Admin escreve (/api/emitir
    // debita, /api/exame devolve). O `registrarConsumo` do cliente que existia
    // em src/lib/billing.ts era codigo morto sem chamador — apagado na
    // triade da onda 2 (fix-wave, 30/08). Com `auth()` aqui, qualquer logado
    // forjava devolucao ('cancelamento') e zerava a conta de consumo da
    // propria clinica.
    match /consumo/{consumoId} {
      allow create: if false;
      allow read:   if superadmin();
      allow update, delete: if false;
    }
    match /creditosLog/{logId} {
      allow create, read: if superadmin();
      allow update, delete: if false;
    }

    // ── Direx ──
    match /configPlanos/{docId} {
      allow read:  if auth();
      allow write: if superadmin();
    }
    match /pagamentos/{pagId}          { allow read, write: if superadmin(); }
    match /historicoFinanceiro/{mesId} { allow read, write: if superadmin(); }

    // ── Legado (some no Plano 3) ──
    match /profiles/{profId} {
      allow get:   if auth() && (profId == uid() || superadmin());
      allow write: if false;
    }
    match /memberships/{memId} {
      allow get, list: if superadmin() || (auth() && resource.data.medicoUid == uid());
      allow write:     if false;
    }

    // ── CONVITES ── 100% servidor (Admin SDK). O cliente nunca le o token nem
    // cria/aceita pelo navegador: convite e aceite passam por /api/convite.
    match /convites/{conviteId} {
      allow read, write: if false;
    }

    // ── Tudo o mais: fechado ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
