{
    "name": "souleo",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "secao1:inventario": "node --env-file=.env.local scripts/secao1/00-inventario.mjs",
        "secao1:regras-publicadas": "node --env-file=.env.local scripts/secao1/00-regras-publicadas.mjs",
        "secao1:migrar": "node --env-file=.env.local scripts/secao1/01-migrar-contas.mjs",
        "secao1:vincular": "node --env-file=.env.local scripts/secao1/02-vincular-membro.mjs",
        "secao1:sincronizar-assinatura": "node --env-file=.env.local scripts/secao1/03-sincronizar-assinatura.mjs",
        "secao1:publicar-regras": "node --env-file=.env.local scripts/secao1/04-publicar-regras.mjs",
        "integracoes:migrar": "node --env-file=.env.local scripts/integracoes/01-migrar.mjs",
        "integracoes:limpar": "node --env-file=.env.local scripts/integracoes/02-limpar-campos-antigos.mjs",
        "imagens:privar": "node --env-file=.env.local scripts/imagens-privar.mjs",
        "shadow:retroativo": "node --env-file=.env.local --import ./tests/unit/register-ts-resolve-hook.mjs scripts/shadow/retroativo.mjs",
        "test:unit": "node --import ./tests/unit/register-ts-resolve-hook.mjs --test tests/unit/*.test.mjs",
        "test:rules": "npx firebase emulators:exec --only firestore --project leo-testes \"node --test tests/rules/regras.test.mjs\"",
        "test:api": "npx firebase emulators:exec --only firestore,auth --project leo-testes \"node --import ./tests/unit/register-ts-resolve-hook.mjs --test tests/api/*.test.mjs\"",
        "test:e2e": "playwright test",
        "test:e2e:login": "node tests/e2e/save-auth.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.88.0",
        "@sentry/nextjs": "^10.48.0",
        "@sparticuz/chromium": "^148.0.0",
        "@tiptap/extension-bullet-list": "^3.22.3",
        "@tiptap/extension-list-item": "^3.22.3",
        "@tiptap/extension-ordered-list": "^3.22.3",
        "@tiptap/extension-placeholder": "^3.22.3",
        "@tiptap/extension-text-align": "^3.22.3",
        "@tiptap/extension-underline": "^3.22.3",
        "@tiptap/pm": "^3.22.3",
        "@tiptap/react": "^3.22.3",
        "@tiptap/starter-kit": "^3.22.3",
        "docx": "^9.6.1",
        "file-saver": "^2.0.5",
        "firebase": "^12.11.0",
        "firebase-admin": "^13.8.0",
        "next": "16.2.3",
        "puppeteer-core": "^24.42.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "recharts": "^3.8.1"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.3",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
