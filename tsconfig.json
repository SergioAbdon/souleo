{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Permite import relativo com extensao .ts explicita (ex: './dicom-sr-mapping.ts')
    // — necessario pra um lib reusar outro lib E continuar rodavel direto por
    // `node --test` (Node 24 nativo NAO resolve import sem extensao nem alias
    // '@/', so path relativo com extensao). noEmit:true ja presente = seguro
    // (S4-T13).
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/senna90/tests/**",
    "src/senna90/smoke-test.ts",
    "src/senna90/shadow-mode.ts",
    "apps/wader/**",
    "scripts/**"
  ]
}
